# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_queue_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_queue_db?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=supersecret_jwt_key_for_smart_queue_hospital_2026
JWT_EXPIRE=7d
